# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- LLM provider -----------------------------------------------------------
# Which provider to use: google | openai | anthropic | openrouter
LLM_PROVIDER=google
# Model name for the chosen provider, e.g.:
#   google     -> gemini-2.0-flash
#   openai     -> gpt-4o
#   anthropic  -> claude-sonnet-4-5
#   openrouter -> openai/gpt-4o-mini  (namespaced "vendor/model", see openrouter.ai/models)
LLM_MODEL=gemini-2.0-flash

# Only the active provider's key is required.
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/your_db

# --- Flask ------------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-secret

# Logging verbosity for LLM/app logs: INFO (default) or DEBUG (logs full schema)
LOG_LEVEL=INFO

# Set to 1 for auto-reload on code changes during development (do not use in prod)
FLASK_DEBUG=0

# Optional: where uploaded files are stored (defaults to "uploads")
# UPLOAD_FOLDER=uploads
